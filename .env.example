# Copy to .env (same folder) and fill in. The server reads it at start-up.
# AI extraction of uploaded lab reports (PDF, photo, scan) via the Claude API:
ANTHROPIC_API_KEY=
# Optional: model used for extraction (default claude-sonnet-5; claude-haiku-4-5-20251001 is cheaper/faster)
# ONCOCARE_EXTRACTION_MODEL=claude-sonnet-5
# Optional: auto (default) uses AI when a key is set; "rules" forces the offline text-layer parser
# ONCOCARE_EXTRACTION=auto
# Optional: DailyMed label fetching for the CTCAE context layer: auto (default) or off
# ONCOCARE_DAILYMED=auto

# Clinic time zone for "today", treatment dates and reminders (default Asia/Kolkata)
# ONCOCARE_TZ=Asia/Kolkata
# Shown in WhatsApp messages and automatic replies
# ONCOCARE_CLINIC_NAME=Thravi OncoCare
# ONCOCARE_CARE_PHONE=+91 80000 00000
# ONCOCARE_PUBLIC_URL=https://onco.thravi.in

# WhatsApp: "simulator" (default, nothing leaves the server) or "live" (WhatsApp Business Cloud API)
# WHATSAPP_MODE=simulator
# WHATSAPP_TOKEN=            # permanent System User token
# WHATSAPP_PHONE_NUMBER_ID=  # from WhatsApp Manager / API setup
# WHATSAPP_DISPLAY_NUMBER=+91 ...
# WHATSAPP_VERIFY_TOKEN=     # any secret string; enter the same value in the Meta webhook settings
# WHATSAPP_APP_SECRET=       # Meta app secret, used to check webhook signatures (required when ONCOCARE_PUBLIC=1)
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_SHARED_NUMBER=0     # 1 when the number is shared with another Thravi product: unknown senders are ignored

# Voice for the WhatsApp agent (Sarvam AI: speech-to-text for voice notes, text-to-speech for spoken replies)
# SARVAM_API_KEY=
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=priya
